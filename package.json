{
  "name": "draftwise-fantasy-draft-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "data:download": "node scripts/download_player_data.mjs",
